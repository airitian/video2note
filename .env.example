# 复制为 .env 后填写；也可以直接在网页「⚙️ 设置」里填写（保存到 data/settings.json）
# 优先级：内置默认值 < data/settings.json < data/secrets.json < 环境变量（环境变量最高）

# ---- 语音识别：模力方舟 / Gitee AI（OpenAI 兼容的 /v1/audio/transcriptions）----
V2N_ASR_API_KEY=
V2N_ASR_BASE_URL=https://api.moark.com/v1
V2N_ASR_MODEL=SenseVoiceSmall
V2N_ASR_LANGUAGE=zh
# 可用模型：SenseVoiceSmall / whisper-large-v3-turbo / whisper-large-v3 /
#           whisper-large / whisper-base / Fun-ASR-Nano-2512 / GLM-ASR / TeleASR-MultiDialect

# ---- 大模型整理 ----
# 协议：anthropic（/v1/messages + x-api-key，如 api.pateway.ai）
#       openai  （/v1/chat/completions，如模力方舟 / DeepSeek 官方）
V2N_LLM_PROTOCOL=anthropic
V2N_LLM_BASE_URL=https://api.pateway.ai/v1
V2N_LLM_API_KEY=
V2N_LLM_MODEL=deepseek-v4.1-flash
V2N_LLM_MAX_TOKENS=8192
V2N_LLM_TEMPERATURE=0.3

# 环境变量别名：ASR 密钥也可写 MOARK_API_TOKEN，LLM 密钥也可写 PATEWAY_API_KEY

# ---- 长音频切片与并发 ----
# 片长越短，转写结果出得越早（SSE 增量推送更及时），代价是请求数变多
V2N_CHUNK_SECONDS=180
V2N_MAX_CONCURRENCY=4

# ---- 下载与风控 ----
# B站高清 / 抖音风控需要 Cookie：chrome / edge / firefox / brave / chromium ...
V2N_COOKIE_BROWSER=
# 或指定 Netscape 格式 cookies.txt
V2N_COOKIE_FILE=
V2N_PROXY=
V2N_FFMPEG_PATH=

# ---- 服务 ----
# 数据落地目录，留空则用项目内的 data/；容器部署建议指向挂载卷（如 /data）
V2N_DATA_DIR=
# 启动参数优先级更高：python run.py --host 0.0.0.0 --port 8765
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# 反向代理带路径前缀时使用：python run.py --root-path /v2n
ROOT_PATH=
# 同时处理几个转写任务
MAX_WORKERS=2
DEBUG_MODE=false
