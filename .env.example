# 复制为 .env 后填写；也可以直接在网页「设置」里填写（保存到 data/settings.json）
# ---- 语音识别：模力方舟 / Gitee AI（https://ai.gitee.com 控制台获取 Token）----
V2N_ASR_API_KEY=
V2N_ASR_BASE_URL=https://api.moark.com/v1
V2N_ASR_MODEL=SenseVoiceSmall
V2N_ASR_LANGUAGE=zh
# 可用模型：SenseVoiceSmall / whisper-large-v3-turbo / whisper-large-v3 /
#           whisper-large / whisper-base / Fun-ASR-Nano-2512 / GLM-ASR / TeleASR-MultiDialect

# ---- 大模型整理 ----
# 协议：anthropic（/v1/messages + x-api-key，如 api.pateway.ai）
#       openai  （/v1/chat/completions，如模力方舟 / DeepSeek 官方）
V2N_LLM_PROTOCOL=anthropic
V2N_LLM_BASE_URL=https://api.pateway.ai/v1
V2N_LLM_API_KEY=
V2N_LLM_MODEL=deepseek-v4.1-flash
V2N_LLM_MAX_TOKENS=8192
V2N_LLM_TEMPERATURE=0.3

# 环境变量别名：ASR 密钥也可写 MOARK_API_TOKEN，LLM 密钥也可写 PATEWAY_API_KEY

# ---- 长音频切片与并发 ----
V2N_CHUNK_SECONDS=600
V2N_MAX_CONCURRENCY=4

# B站高清 / 抖音风控 需要 Cookie：chrome / edge / firefox
V2N_COOKIE_BROWSER=
# 或指定 Netscape 格式 cookies.txt
V2N_COOKIE_FILE=
V2N_PROXY=
V2N_FFMPEG_PATH=

# ===== Gradio 版运行时（app.py）=====
# ModelScope 创空间固定端口，本地改端口时用它
SERVER_PORT=7860
SERVER_HOST=0.0.0.0
DEBUG_MODE=false
# 同时处理几个转写任务
MAX_WORKERS=2
# 数据落地目录，留空则用 /mnt/workspace/video2note（创空间持久化）或项目内 data/
V2N_DATA_DIR=

# ===== ModelScope 创空间 Docker 类型（Dockerfile）=====
# 镜像入口：app=Gradio 版（默认），run=FastAPI 本地版
APP_ENTRY=app
# 容器在网关后面时需要的前缀；留空表示根路径。
# 多数情况 Gradio 能自己从 X-Forwarded-Prefix 推断，不用手动设。
GRADIO_ROOT_PATH=
# 同一前缀给 FastAPI 版用（run.py 读 ROOT_PATH / FASTAPI_ROOT_PATH）
ROOT_PATH=
# 构建时是否装 Chromium（仅 pyktok 抖音签名需要）：
#   docker build --build-arg INSTALL_PLAYWRIGHT=0 .   # 镜像小约 1.3GB
# 平台构建参数在创空间「设置 → 高级 / 构建参数」里填
# INSTALL_PLAYWRIGHT=1

# ===== 手动同步到 ModelScope 创空间（scripts/sync_to_studio.sh）=====
# 创空间访问令牌，用于 git push，不是运行时配置
# 获取：https://modelscope.cn/my/myaccesstoken
V2N_STUDIO_TOKEN=
V2N_STUDIO=viva25/video_txt
